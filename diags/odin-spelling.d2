# odin-spelling: its place in the binding graph
# Render:  d2 diags/odin-spelling.d2 diags/odin-spelling.svg

direction: down

title: "odin-spelling" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-spelling\nlibspelling 0.2.0" {
  style.fill: "#eef6ff"
}
lib: "libspelling-1 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"spelling:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection spelling
this -> lib: foreign import
